{
	"extends": "astro/tsconfigs/base",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@components/*": ["./src/components/*"],
			"@interfaces/*": ["./src/interfaces/*"],
			"@layouts/*": ["./src/layouts/*"],
			"@consts/*": ["./src/consts/*"]
		}
	},
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"]
}